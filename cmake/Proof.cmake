# Optional, genuine Rust proof implementation. No fallback to cp_proof_stub.cpp.
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR
   NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
  message(FATAL_ERROR "The recorded proof profiles require native x86_64")
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(proof_target "x86_64-unknown-linux-gnu")
  set(proof_filename "libcp_proof_ffi.a")
  set(proof_crt "system")
elseif(WIN32 AND CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
  set(proof_target "x86_64-pc-windows-msvc")
  set(proof_filename "cp_proof_ffi.lib")
  set(proof_crt "dynamic")
  if(CMAKE_CONFIGURATION_TYPES)
    if(NOT CMAKE_CONFIGURATION_TYPES STREQUAL "Release")
      message(FATAL_ERROR "The MSVC proof recipe requires -DCMAKE_CONFIGURATION_TYPES=Release")
    endif()
  elseif(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
    message(FATAL_ERROR "The MSVC proof recipe requires -DCMAKE_BUILD_TYPE=Release")
  endif()
  if(NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDLL")
    message(FATAL_ERROR "Match the Rust dynamic release CRT with -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreadedDLL")
  endif()
else()
  message(FATAL_ERROR "Proof linking supports native Linux x86_64 or Windows x64 MSVC only")
endif()

set(NEURO_PROOF_LIBRARY "${CMAKE_SOURCE_DIR}/build/proof-target/${proof_target}/release/${proof_filename}"
    CACHE FILEPATH "Real Rust proof static library for this native target")

set(NEURO_PROOF_BUILD_REPORT "${CMAKE_SOURCE_DIR}/artifacts/proof-build.json"
    CACHE FILEPATH "Successful pinned Rust build report")
if(NOT EXISTS "${NEURO_PROOF_LIBRARY}" OR NOT EXISTS "${NEURO_PROOF_BUILD_REPORT}")
  message(FATAL_ERROR "Build the real proof dependency first: python tools/build_pearl_proof.py")
endif()
file(READ "${NEURO_PROOF_BUILD_REPORT}" proof_report)
string(JSON proof_passed ERROR_VARIABLE proof_json_error GET "${proof_report}" passed)
if(proof_json_error OR NOT proof_passed)
  message(FATAL_ERROR "Rust proof build report is invalid or unsuccessful")
endif()
string(JSON proof_schema GET "${proof_report}" schema)
string(JSON reported_target GET "${proof_report}" target)
string(JSON reported_host GET "${proof_report}" toolchain rustc host)
string(JSON reported_crt GET "${proof_report}" crt)
string(JSON reported_profile GET "${proof_report}" profile)
if(NOT proof_schema STREQUAL "neuro.proof_build.v2" OR
   NOT reported_target STREQUAL proof_target OR NOT reported_host STREQUAL proof_target OR
   NOT reported_crt STREQUAL proof_crt OR NOT reported_profile STREQUAL "release")
  message(FATAL_ERROR "Rust proof report does not match the native target, release profile and CRT")
endif()
string(JSON expected_hash GET "${proof_report}" artifacts proof_library sha256)
file(SHA256 "${NEURO_PROOF_LIBRARY}" actual_hash)
if(NOT actual_hash STREQUAL expected_hash)
  message(FATAL_ERROR "Rust static library differs from the verified build artifact")
endif()
string(JSON expected_config GET "${proof_report}" config_sha256)
file(SHA256 "${CMAKE_SOURCE_DIR}/configs/proof-build.json" actual_config)
if(NOT actual_config STREQUAL expected_config)
  message(FATAL_ERROR "Proof configuration changed; rerun the pinned Rust build")
endif()
add_library(neuro_rust_proof STATIC IMPORTED GLOBAL)
set_target_properties(neuro_rust_proof PROPERTIES IMPORTED_LOCATION "${NEURO_PROOF_LIBRARY}")
# Use dependencies emitted by the actual pinned target compiler, including its
# CRT/system libraries. An empty or foreign-platform list cannot pass the gate.
string(JSON native_library_count LENGTH "${proof_report}" native_static_libs)
if(native_library_count LESS 1)
  message(FATAL_ERROR "The verified Rust build did not record native-static-libs")
endif()
math(EXPR native_library_last "${native_library_count} - 1")
set(proof_native_libraries "")
set(proof_native_link_options "")
foreach(index RANGE 0 ${native_library_last})
  string(JSON native_library GET "${proof_report}" native_static_libs ${index})
  if(WIN32)
    if(native_library MATCHES "^/defaultlib:[A-Za-z0-9_.+-]+$")
      # rustc emits the dynamic CRT as a default-library directive. Preserve
      # its semantics, and keep it on the host linker for CUDA-linked clients.
      list(APPEND proof_native_link_options "$<HOST_LINK:LINKER:${native_library}>")
      continue()
    elseif(NOT native_library MATCHES "^[A-Za-z0-9_.+-]+\\.lib$")
      message(FATAL_ERROR "Unexpected Windows native library in the Rust report")
    endif()
  elseif(NOT native_library MATCHES "^-l[A-Za-z0-9_.+-]+$")
    message(FATAL_ERROR "Unexpected Linux native library in the Rust report")
  endif()
  list(APPEND proof_native_libraries "${native_library}")
endforeach()
target_link_libraries(neuro_rust_proof INTERFACE Threads::Threads ${proof_native_libraries})
target_link_options(neuro_rust_proof INTERFACE ${proof_native_link_options})
add_library(neuro_pearl_proof STATIC native/proof/pearl_proof.cpp native/proof/pearl_witness.cpp)
target_include_directories(neuro_pearl_proof PUBLIC native/include)
target_link_libraries(neuro_pearl_proof PUBLIC neuro_pearl_input neuro_fullk_reference neuro_rust_proof)
add_executable(neuro_pearl_proof_cli native/proof/pearl_proof_cli.cpp)
set_target_properties(neuro_pearl_proof_cli PROPERTIES OUTPUT_NAME neuro_pearl_proof)
target_include_directories(neuro_pearl_proof_cli PRIVATE native)
target_link_libraries(neuro_pearl_proof_cli PRIVATE neuro_pearl_proof)
if(NEURO_BUILD_CPU_CHECKS)
  add_executable(neuro_pearl_proof_test native/tests/pearl_proof_test.cpp)
  target_include_directories(neuro_pearl_proof_test PRIVATE native)
  target_link_libraries(neuro_pearl_proof_test PRIVATE neuro_pearl_proof)
  add_test(NAME neuro_pearl_proof COMMAND neuro_pearl_proof_test)
  set_tests_properties(neuro_pearl_proof PROPERTIES TIMEOUT 120)
endif()

include("${CMAKE_SOURCE_DIR}/cmake/Host.cmake")

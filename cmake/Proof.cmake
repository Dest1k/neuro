# Optional, genuine Rust proof implementation. No fallback to cp_proof_stub.cpp.
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "The recorded proof link recipe is Linux 64-bit; validate a separate Windows recipe first")
endif()
set(NEURO_PROOF_LIBRARY "${CMAKE_SOURCE_DIR}/build/proof-target/x86_64-unknown-linux-gnu/release/libcp_proof_ffi.a"
    CACHE FILEPATH "Real Rust proof static library")
set(NEURO_PROOF_BUILD_REPORT "${CMAKE_SOURCE_DIR}/artifacts/proof-build.json"
    CACHE FILEPATH "Successful pinned Rust build report")
if(NOT EXISTS "${NEURO_PROOF_LIBRARY}" OR NOT EXISTS "${NEURO_PROOF_BUILD_REPORT}")
  message(FATAL_ERROR "Build the real proof dependency first: python tools/build_pearl_proof.py")
endif()
file(READ "${NEURO_PROOF_BUILD_REPORT}" proof_report)
string(JSON proof_passed ERROR_VARIABLE proof_json_error GET "${proof_report}" passed)
if(proof_json_error OR NOT proof_passed)
  message(FATAL_ERROR "Rust proof build report is invalid or unsuccessful")
endif()
string(JSON expected_hash GET "${proof_report}" artifacts proof_library sha256)
file(SHA256 "${NEURO_PROOF_LIBRARY}" actual_hash)
if(NOT actual_hash STREQUAL expected_hash)
  message(FATAL_ERROR "Rust static library differs from the verified build artifact")
endif()
string(JSON expected_config GET "${proof_report}" config_sha256)
file(SHA256 "${CMAKE_SOURCE_DIR}/configs/proof-build.json" actual_config)
if(NOT actual_config STREQUAL expected_config)
  message(FATAL_ERROR "Proof configuration changed; rerun the pinned Rust build")
endif()
add_library(neuro_rust_proof STATIC IMPORTED GLOBAL)
set_target_properties(neuro_rust_proof PROPERTIES IMPORTED_LOCATION "${NEURO_PROOF_LIBRARY}")
# Confirmed with cargo rustc -- --print native-static-libs on the pinned target.
target_link_libraries(neuro_rust_proof INTERFACE Threads::Threads ${CMAKE_DL_LIBS} m rt util)
add_library(neuro_pearl_proof STATIC native/proof/pearl_proof.cpp native/proof/pearl_witness.cpp)
target_include_directories(neuro_pearl_proof PUBLIC native/include)
target_link_libraries(neuro_pearl_proof PUBLIC neuro_pearl_input neuro_fullk_reference neuro_rust_proof)
add_executable(neuro_pearl_proof_cli native/proof/pearl_proof_cli.cpp)
set_target_properties(neuro_pearl_proof_cli PROPERTIES OUTPUT_NAME neuro_pearl_proof)
target_include_directories(neuro_pearl_proof_cli PRIVATE native)
target_link_libraries(neuro_pearl_proof_cli PRIVATE neuro_pearl_proof)
if(NEURO_BUILD_CPU_CHECKS)
  add_executable(neuro_pearl_proof_test native/tests/pearl_proof_test.cpp)
  target_include_directories(neuro_pearl_proof_test PRIVATE native)
  target_link_libraries(neuro_pearl_proof_test PRIVATE neuro_pearl_proof)
  add_test(NAME neuro_pearl_proof COMMAND neuro_pearl_proof_test)
  set_tests_properties(neuro_pearl_proof PROPERTIES TIMEOUT 120)
endif()
